# PostgreSQL connection string. Require TLS in production (for Supabase, keep sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Direct, non-pooler URL used only by Prisma migration commands.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate independent random secrets, for example: openssl rand -base64 48
AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
TOKEN_ENCRYPTION_KEY="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET"

# Required only to create the very first administrator. Rotate or remove it afterwards.
INITIAL_SETUP_SECRET="REPLACE_WITH_A_ONE_TIME_RANDOM_SECRET"

# Public HTTPS origin, without a trailing slash.
APP_URL="https://your-domain.example"

# Gmail integration (optional until Gmail sync is enabled).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.example/api/gmail/callback"

# NQ Logistics tax code used to distinguish input and output invoices.
NQ_TAX_CODE="4900917685"

# Private Supabase Storage bucket for PDF/Excel/XML/image attachments. Keep the service-role key
# server-side only. Create this bucket as private before the first production upload.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="logistics-attachments"

# Used only by the hosting cron job that calls POST /api/gmail/sync every five minutes.
# Generate with: openssl rand -base64 48
CRON_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET"
