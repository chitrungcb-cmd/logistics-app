{
  "name": "logistics-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/deploy-database-migrations.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:production-env": "node scripts/check-production-env.mjs",
    "prestart": "npm run check:production-env",
    "postinstall": "node scripts/patch-brace-expansion-compat.mjs && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:sync-shipment-debts": "node scripts/sync-shipment-debts.mjs",
    "storage:audit": "node scripts/migrate-private-attachments.mjs --verify",
    "storage:migrate": "node scripts/migrate-private-attachments.mjs --apply --verify",
    "storage:migrate-to-r2": "node scripts/migrate-supabase-storage-to-r2.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "googleapis": "^173.0.0",
    "jose": "^6.2.4",
    "jszip": "^3.10.1",
    "next": "^16.2.12",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.9.2",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "find-my-way": "9.7.0",
    "valibot": "1.4.2",
    "sharp": "$sharp",
    "postcss": "8.5.23",
    "uuid": "11.1.1"
  }
}
