// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id               String     @id @default(cuid())
  companyName      String
  taxCode          String     @unique
  address          String?
  legalRepName     String?
  legalRepIdNumber String?
  phone            String?
  email            String?
  notes            String?
  assignedUser     User?      @relation("CustomerAssignments", fields: [assignedUserId], references: [id])
  assignedUserId   String?
  shipments        Shipment[]
  debts            Debt[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Shipment {
  id                  String              @id @default(cuid())
  shipmentCode        String              @unique
  customerName        String
  customer            Customer?           @relation(fields: [customerId], references: [id])
  customerId          String?
  taxCode             String?
  declarationNo       String?
  declarationDate     DateTime?
  invoiceNo           String?
  customsType         String?
  port                String?
  goodsName           String?
  channel             String?
  status              String              @default("Đang làm thủ tục")
  customsOffice       String?
  transport           String?
  transportRoute      String?
  vehiclePlate        String?
  totalAmount         Float               @default(0)
  attachments         Json?
  note                String?
  consultationDate    DateTime?
  declarationBranches Json?
  // Phân bổ báo giá nhập tay: khi một trong hai giá trị khác null thì Tổng báo giá = tổng hai
  // giá trị này (thay cho tổng bảng chi tiết). Null = chưa nhập tay, dùng tổng dòng như cũ.
  quoteInvoiceAmount   Float?
  quoteNoInvoiceAmount Float?
  tasks               Task[]
  notifications       Notification[]
  costs               ShipmentCost[]
  quotes              Quote[]
  quoteLines          ShipmentQuoteLine[]
  conversations       Conversation[]
  debts               Debt[]
  vendorInvoices      VendorInvoice[]
  personalAccountEntry PersonalAccountEntry?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([declarationDate, createdAt])
  @@index([status])
  @@index([channel])
}

enum CostCategory {
  HAI_QUAN
  BIEN_PHONG
  KIEM_DICH
  HA_TANG
  BEN_BAI
  SANG_TAI
  VAN_TAI
  HOA_HONG
  KHAC
}

// Detailed cost-line ledger for a shipment. costPrice (what NQ Logistics actually pays out) always
// counts toward Tổng chi phí; sellPrice only counts toward Tổng thu when isAdditional is true — costs
// already covered by the quote don't get counted twice. ADMIN-only data (see CLAUDE.md "Profit
// visibility"): ACCOUNTANT must never see costPrice or anything profit-derived from it.
model ShipmentCost {
  id             String          @id @default(cuid())
  shipment       Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId     String
  category       CostCategory
  unitPrice      Float           @default(0)
  quantity       Float           @default(1)
  // Always server-computed as unitPrice * quantity (see /api/costs) — never accept this directly
  // from a client write.
  costPrice      Float           @default(0)
  sellPrice      Float           @default(0)
  isAdditional   Boolean         @default(false)
  // Preset-generated rows remain estimates until a user edits or explicitly confirms them.
  isActual       Boolean         @default(true)
  invoiceNumber  String?
  attachmentUrl  String?
  // Đơn vị tính (lần, xe, chuyến...) và tên hạng mục tùy chỉnh do người dùng gõ — category enum vẫn
  // giữ nguyên cho màu sắc/so sánh/cảnh báo; customLabel chỉ là nhãn hiển thị thêm cho từng dòng.
  unit           String?
  customLabel    String?
  note           String?
  // Người đứng ra chi khoản này ("do ai chi") — mô-đun Tài khoản cá nhân tổng hợp "ai chi bao nhiêu".
  // SetNull khi user bị xóa để không vỡ FK (user chỉ bị khóa chứ hiếm khi xóa, xem User.isActive).
  paidBy         User?           @relation("CostPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  paidByUserId   String?
  // "Chi từ TK": trỏ tới 1 tài khoản công ty; nếu null mà paidByUserId có giá trị = chi từ TK cá nhân
  // người đó; cả hai null = chưa chọn. Đúng một trong hai được đặt. Dùng cho báo cáo thu–chi theo TK.
  paidFromCompanyAccount   CompanyAccount? @relation("CostPaidFromCompanyAccount", fields: [paidFromCompanyAccountId], references: [id], onDelete: SetNull)
  paidFromCompanyAccountId String?
  // Xác nhận "đã thanh toán" trong công nợ Phải trả: người phụ trách (paidBy) hoặc ADMIN tích vào.
  // isPaid = đã trả; paidAt = thời điểm tích; paidConfirmedBy = người bấm tích (thường là paidBy).
  isPaid                   Boolean         @default(false)
  paidAt                   DateTime?
  paidConfirmedBy          User?           @relation("CostPaidConfirmedBy", fields: [paidConfirmedByUserId], references: [id], onDelete: SetNull)
  paidConfirmedByUserId    String?
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId       String?
  preset         CostPreset?     @relation(fields: [presetId], references: [id], onDelete: SetNull)
  presetId       String?
  auditLogs      CostAuditLog[]
  vendorInvoices VendorInvoice[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([shipmentId, presetId])
  @@index([vendorId])
  @@index([paidByUserId])
  @@index([paidFromCompanyAccountId])
  @@index([shipmentId, createdAt])
}

// Tài khoản công ty (nhiều TK ngân hàng, có thể thuộc cả 2 công ty) — nguồn chi/thu chính thức.
// "Chi từ TK" trên chi phí trỏ vào đây; báo cáo thu–chi tổng hợp theo từng tài khoản.
model CompanyAccount {
  id        String         @id @default(cuid())
  name      String
  isActive  Boolean        @default(true)
  costs     ShipmentCost[] @relation("CostPaidFromCompanyAccount")
  paymentsReceived Payment[] @relation("PaymentReceivedToCompanyAccount")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum OtherExpenseCategory {
  TIEP_KHACH
  AN_UONG
  VAN_PHONG_PHAM
  DI_LAI
  DIEN_NUOC_INTERNET
  THUE_VAN_PHONG
  SUA_CHUA_BAO_TRI
  PHI_NGAN_HANG
  KHAC
}

// Chi phí vận hành chung, hoàn toàn độc lập với ShipmentCost và tài chính/công nợ từng lô hàng.
model OtherExpense {
  id             String               @id @default(cuid())
  category       OtherExpenseCategory
  description    String
  amount         Float
  expenseDate    DateTime
  payee          String?
  paymentMethod  String?
  invoiceNumber  String?
  attachmentName String?
  attachmentUrl  String?
  note           String?
  createdBy      User?                @relation("OtherExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([expenseDate])
  @@index([category])
  @@index([createdById])
}

// Bảng giá chi phí được thiết lập trước theo nhóm tên hàng. Khi lô có số tờ khai, các dòng đang
// hoạt động được sao chép sang ShipmentCost và liên kết bằng presetId để không tạo trùng.
model CostPreset {
  id            String         @id @default(cuid())
  goodsName     String
  goodsKeyword  String
  category      CostCategory
  unitPrice     Float
  quantity      Float          @default(1)
  note          String?
  vendor        Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId      String?
  isActive      Boolean        @default(true)
  shipmentCosts ShipmentCost[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([goodsKeyword, category])
  @@index([vendorId])
}

enum CostAuditAction {
  CREATE
  UPDATE
  DELETE
}

// One row per create/update/delete on a ShipmentCost — "ai sửa hay thao tác sẽ có lịch sử thao tác".
// shipmentCostId is nullable + onDelete: SetNull specifically so a DELETE action's log entry survives
// the row itself being deleted (that's the whole point of logging a delete). shipmentId is stored
// directly (not just derived through shipmentCost) for the same reason — still queryable by shipment
// after the cost row is gone.
model CostAuditLog {
  id             String          @id @default(cuid())
  shipmentCost   ShipmentCost?   @relation(fields: [shipmentCostId], references: [id], onDelete: SetNull)
  shipmentCostId String?
  shipmentId     String
  user           User            @relation(fields: [userId], references: [id])
  userId         String
  action         CostAuditAction
  detail         String
  createdAt      DateTime        @default(now())
}

// A shipment can accumulate several quote revisions over time; only the most recent (by createdAt)
// counts as the active quoteAmount for profit calculations — see mergeDeclarationBranch-style "latest
// wins" precedent elsewhere in this codebase. Visible to ADMIN and ACCOUNTANT (customer-facing
// quoting), unlike ShipmentCost.
model Quote {
  id            String    @id @default(cuid())
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId    String
  quoteAmount   Float
  quoteDate     DateTime?
  attachmentUrl String?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shipmentId, createdAt])
}

enum QuoteLineCategory {
  THU_TUC_HAI_QUAN
  VAN_TAI
  DANG_KIEM
  PHAT_SINH
}

// Bảng báo giá hiện hành theo bốn hạng mục cố định. Tách khỏi ShipmentCost để chi phí nội bộ và
// báo giá khách hàng có thể sửa độc lập trong cùng màn hình.
model ShipmentQuoteLine {
  id          String             @id @default(cuid())
  shipment    Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId  String
  category    QuoteLineCategory?
  description String
  quantity    Float              @default(1)
  unit        String?
  unitPrice   Float              @default(0)
  amount      Float              @default(0)
  hasInvoice  Boolean            @default(false)
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// "Tài khoản cá nhân" — theo dõi phần báo giá KHÔNG hóa đơn của từng lô hàng (mỗi lô tối đa một
// dòng, `shipmentId` unique). `amount` luôn được đồng bộ từ báo giá (syncPersonalAccountEntry,
// src/lib/personal-account-sync.ts) — không sửa tay; các trường còn lại (ngày thanh toán, số TK
// nhận tiền, người phụ trách, ghi chú) điền tay trong mô-đun /personal-account. Số tờ khai/ngày
// tờ khai/tên hàng đọc từ quan hệ Shipment, không sao chép sang đây.
model PersonalAccountEntry {
  id               String    @id @default(cuid())
  shipment         Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId       String    @unique
  amount           Float     @default(0)
  paymentDate      DateTime?
  receivingAccount String?
  assignedUser     User?     @relation("PersonalAccountAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedUserId   String?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([paymentDate])
  @@index([assignedUserId])
}

// Đối tác NQ Logistics trả tiền cho (hãng vận tải/kho bãi/đại lý hải quan/khác) — free-text `type`
// rather than an enum since this list isn't as fixed as CostCategory.
model Vendor {
  id            String          @id @default(cuid())
  name          String
  type          String?
  phone         String?
  address       String?
  taxCode       String?
  note          String?
  debts         Debt[]
  shipmentCosts ShipmentCost[]
  costPresets   CostPreset[]
  invoices      VendorInvoice[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum InvoiceReconciliationStatus {
  MATCHED
  UNMATCHED
  NEEDS_REVIEW
}

// Hóa đơn đầu vào/đầu ra được đọc từ Gmail của NQ Logistics. sourceKey là khóa Gmail + attachment
// giúp đồng bộ lặp lại an toàn; hóa đơn đầu vào được ghép với chi phí theo số hóa đơn/nhà cung cấp.
model VendorInvoice {
  id             String                      @id @default(cuid())
  sourceKey      String                      @unique
  gmailMessageId String
  gmailThreadId  String?
  emailSubject   String?
  emailFrom      String?
  vendor         Vendor?                     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId       String?
  shipmentCost   ShipmentCost?               @relation(fields: [shipmentCostId], references: [id], onDelete: SetNull)
  shipmentCostId String?
  shipment       Shipment?                   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  shipmentId     String?
  sellerName     String?
  sellerTaxCode  String?
  buyerName      String?
  buyerTaxCode   String?
  isIssuedToNq   Boolean?
  invoiceNumber  String?
  invoiceSymbol  String?
  invoiceDate    DateTime?
  subtotal       Float?
  taxAmount      Float?
  totalAmount    Float?
  currency       String                      @default("VND")
  attachmentName String
  attachmentUrl  String
  xmlUrl         String?
  pdfUrl         String?
  status         InvoiceReconciliationStatus @default(NEEDS_REVIEW)
  note           String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([gmailMessageId])
  @@index([vendorId])
  @@index([shipmentCostId])
  @@index([shipmentId])
  @@index([status])
  @@index([invoiceDate])
  @@index([sellerTaxCode])
  @@index([invoiceNumber])
}

enum DebtType {
  RECEIVABLE
  PAYABLE
}

// Only UNPAID/PARTIAL/PAID are ever stored — always server-recomputed from paidAmount (see
// computeDebtStatus() in src/lib/debt-constants.ts), never accepted directly from a client write.
// "Quá hạn" (overdue) is deliberately NOT a 4th stored value: it's a display-only flag derived from
// dueDate + status at read time (see isOverdue()), because a debt can be simultaneously "quá hạn" and
// "PARTIAL" — collapsing that into one enum would lose whichever fact isn't picked as the stored value.
enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
}

// Một khoản thanh toán của công nợ phải thu có tách hóa đơn trỏ về đúng phần nào. Null với công nợ
// không tách (trả vào tổng chung như trước).
enum DebtPortion {
  INVOICE
  NO_INVOICE
}

// type=RECEIVABLE uses customerId (tiền khách hàng nợ NQ Logistics); type=PAYABLE uses vendorId (tiền
// NQ Logistics nợ nhà cung cấp/đối tác) — the two id fields are mutually exclusive by convention of
// `type`, not enforced at the DB level (see validation in POST /api/debts).
model Debt {
  id          String     @id @default(cuid())
  type        DebtType
  // Khóa chỉ có ở công nợ đồng bộ từ tài chính lô hàng; unique để mọi lần lưu sau chỉ upsert.
  sourceKey   String?    @unique
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId  String?
  vendor      Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId    String?
  shipment    Shipment?  @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  shipmentId  String?
  totalAmount Float
  // Tách phần có hóa đơn (chưa VAT) / không hóa đơn của công nợ phải thu đồng bộ từ báo giá. Cả hai
  // null = công nợ KHÔNG tách (mặc định, mọi công nợ phải trả và công nợ nhập tay) — thanh toán trừ
  // vào tổng chung. Khi tách, invoiceAmount + noInvoiceAmount = totalAmount và mỗi Payment gắn portion.
  invoiceAmount   Float?
  noInvoiceAmount Float?
  dueDate     DateTime?
  status      DebtStatus @default(UNPAID)
  note        String?
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type, createdAt])
  @@index([dueDate])
}

model Payment {
  id            String       @id @default(cuid())
  debt          Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  debtId        String
  amount        Float
  paymentDate   DateTime
  method        String?
  // "TK nhận tiền": thu vào TK công ty (receivedToCompanyAccountId) hoặc TK cá nhân của một người
  // (receivedByUserId) — loại trừ nhau. Đối xứng với "Chi từ TK" bên ShipmentCost, để theo dõi dòng
  // tiền công ty vs cá nhân. SetNull khi bản ghi gốc bị xóa để không vỡ FK.
  receivedToCompanyAccount   CompanyAccount? @relation("PaymentReceivedToCompanyAccount", fields: [receivedToCompanyAccountId], references: [id], onDelete: SetNull)
  receivedToCompanyAccountId String?
  receivedBy                 User?           @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  receivedByUserId           String?
  // Phần được trả (chỉ dùng cho công nợ phải thu tách hóa đơn); null với công nợ không tách.
  portion       DebtPortion?
  attachmentUrl String?
  note          String?
  createdAt     DateTime     @default(now())

  @@index([receivedToCompanyAccountId])
  @@index([receivedByUserId])
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  FIELD_STAFF
}

model User {
  id                      String               @id @default(cuid())
  email                   String               @unique
  passwordHash            String
  name                    String
  role                    UserRole             @default(FIELD_STAFF)
  // Danh sách mô-đun được phép mở. Vai trò vẫn quyết định các thao tác nhạy cảm bên trong mô-đun.
  modulePermissions       String[]             @default([])
  // Soft lock instead of delete (audit 3.3): a departed employee is locked, not deleted, so their
  // task/message history stays intact and no FK constraints break. A locked user can't log in and
  // getCurrentUser() treats them as unauthenticated, so any live session stops working immediately.
  isActive                Boolean              @default(true)
  tasksAssigned           Task[]               @relation("AssignedTasks")
  tasksCreated            Task[]               @relation("CreatedTasks")
  customersAssigned       Customer[]           @relation("CustomerAssignments")
  notifications           Notification[]
  costAuditLogs           CostAuditLog[]
  costsPaid               ShipmentCost[]       @relation("CostPaidBy")
  costsPaidConfirmed      ShipmentCost[]       @relation("CostPaidConfirmedBy")
  paymentsReceived        Payment[]            @relation("PaymentReceivedBy")
  otherExpensesCreated    OtherExpense[]       @relation("OtherExpenseCreator")
  taskStatusLogs          TaskStatusLog[]
  conversationsCreated    Conversation[]       @relation("CreatedConversations")
  conversationMemberships ConversationMember[]
  sentMessages            Message[]            @relation("SentMessages")
  mentions                MessageMention[]     @relation("MentionedInMessages")
  personalAccountEntries  PersonalAccountEntry[] @relation("PersonalAccountAssignee")
  passwordResetsReceived  PasswordResetLog[]   @relation("ResetTarget")
  passwordResetsPerformed PasswordResetLog[]   @relation("ResetBy")
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
}

// Audit trail for BƯỚC 3 — who reset whose password, when. The password itself is never stored
// anywhere (hashed on write, shown once in the browser); this only records that a reset happened.
model PasswordResetLog {
  id            String   @id @default(cuid())
  targetUser    User     @relation("ResetTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId  String
  resetBy       User     @relation("ResetBy", fields: [resetByUserId], references: [id])
  resetByUserId String
  createdAt     DateTime @default(now())
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id                String          @id @default(cuid())
  title             String
  description       String?
  assignedTo        User            @relation("AssignedTasks", fields: [assignedToUserId], references: [id])
  assignedToUserId  String
  status            TaskStatus      @default(TODO)
  dueDate           DateTime?
  relatedShipment   Shipment?       @relation(fields: [relatedShipmentId], references: [id])
  relatedShipmentId String?
  attachmentUrl     String?
  createdBy         User            @relation("CreatedTasks", fields: [createdByUserId], references: [id])
  createdByUserId   String
  notifications     Notification[]
  statusLogs        TaskStatusLog[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([relatedShipmentId, title])
  @@index([assignedToUserId, createdAt])
  @@index([createdAt])
}

// Lưu lịch sử tích/chuyển trạng thái tiến trình để biết ai thao tác và thời điểm nào.
model TaskStatusLog {
  id          String     @id @default(cuid())
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  actor       User       @relation(fields: [actorUserId], references: [id])
  actorUserId String
  fromStatus  TaskStatus
  toStatus    TaskStatus
  createdAt   DateTime   @default(now())
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_PROGRESS_UPDATE
  NEW_MESSAGE
  MENTIONED
  COST_MISSING
}

model Notification {
  id                    String           @id @default(cuid())
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  type                  NotificationType
  message               String
  relatedTask           Task?            @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  relatedTaskId         String?
  relatedShipment       Shipment?        @relation(fields: [relatedShipmentId], references: [id], onDelete: SetNull)
  relatedShipmentId     String?
  relatedConversation   Conversation?    @relation(fields: [relatedConversationId], references: [id], onDelete: SetNull)
  relatedConversationId String?
  isRead                Boolean          @default(false)
  // Optional idempotency key for recurring system alerts; null for ordinary task/chat notifications.
  dedupeKey             String?          @unique
  createdAt             DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

enum ConversationType {
  DIRECT
  GROUP
  COMPANY
}

// COMPANY: exactly one row exists app-wide, containing every user (see ensureCompanyConversation() in
// src/lib/chat.ts) — auto-created lazily on first access rather than at "app startup" (there's no such
// hook in this serverless-style Next.js deployment) and every new user is auto-added when created (see
// POST /api/users). DIRECT: found-or-created per unique pair of users, never duplicated (see
// findOrCreateDirectConversation()). GROUP: created ad hoc by any role via POST /api/conversations,
// optionally tied to relatedShipmentId so the shipment detail page can link back to it.
model Conversation {
  id                String               @id @default(cuid())
  type              ConversationType
  name              String?
  relatedShipment   Shipment?            @relation(fields: [relatedShipmentId], references: [id], onDelete: SetNull)
  relatedShipmentId String?
  createdBy         User                 @relation("CreatedConversations", fields: [createdByUserId], references: [id])
  createdByUserId   String
  members           ConversationMember[]
  messages          Message[]
  notifications     Notification[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

// lastReadAt drives the unread-count badge on /messages — null means "never read", so every message
// counts as unread until the member opens the conversation at least once.
model ConversationMember {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String              @id @default(cuid())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User                @relation("SentMessages", fields: [senderId], references: [id])
  senderId       String
  content        String?
  editedAt       DateTime?
  attachments    MessageAttachment[]
  mentions       MessageMention[]
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String  @id @default(cuid())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  fileUrl   String
  fileName  String
  fileType  String
  fileSize  Int
}

model MessageMention {
  id              String  @id @default(cuid())
  message         Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId       String
  mentionedUser   User    @relation("MentionedInMessages", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  mentionedUserId String
}

// Single-row table: holds the refresh token for the one Gmail mailbox this app syncs from.
model GmailAuth {
  id           String   @id @default(cuid())
  email        String
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Tracks which Gmail messages have already been synced, so re-running sync is idempotent.
model ProcessedEmail {
  id             String   @id @default(cuid())
  gmailMessageId String   @unique
  shipmentId     String?
  status         String
  detail         String?
  processedAt    DateTime @default(now())
}
